rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Checking if the current user is owner/architect jhuffman710@gmail.com
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email_verified == true && 
             request.auth.token.email == 'jhuffman710@gmail.com';
    }

    // Input submission validator
    function isValidSubmission(data) {
      return data.keys().hasAll(['name', 'category', 'description', 'status', 'createdAt'])
             && data.name is string && data.name.size() > 0 && data.name.size() <= 200
             && data.category is string && data.category.size() > 0 && data.category.size() <= 100
             && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
             && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
             && data.createdAt == request.time
             && (!('coordinates' in data) || data.coordinates == null || (data.coordinates is list && data.coordinates.size() == 2))
             && (!('date' in data) || (data.date is string && data.date.size() <= 50))
             && (!('images' in data) || (data.images is list && data.images.size() <= 10))
             && (!('source' in data) || (data.source is string && data.source.size() <= 200));
    }

    // Likes collection: anyone can read and increment
    match /likes/{anomalyId} {
      // Anyone can see how many likes a point has
      allow get, list: if true;

      // Allow creating the first like
      allow create: if isValidId(anomalyId)
                    && request.resource.data.keys().hasAll(['count', 'updatedAt'])
                    && request.resource.data.keys().size() == 2
                    && request.resource.data.count == 1
                    && request.resource.data.updatedAt == request.time;

      // Allow incrementing or decrementing the like count by exactly 1
      allow update: if isValidId(anomalyId)
                    && (
                      request.resource.data.count == resource.data.count + 1 ||
                      (request.resource.data.count == resource.data.count - 1 && request.resource.data.count >= 0)
                    )
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Anyone can read approved records, admin can view all submissions (including pending/rejected)
      allow get, list: if (resource != null && resource.data.status == 'approved') || isAdmin();

      // Anyone can submit new points (must be 'pending')
      allow create: if isValidId(submissionId) 
                    && request.resource.data.status == 'pending'
                    && isValidSubmission(request.resource.data);

      // Only Admin can update or delete submissions
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reports/Flags collection
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isValidId(reportId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(['pointId', 'pointName', 'pointCategory', 'reason', 'details', 'status', 'createdAt'])
                    && request.resource.data.keys().size() == 7
                    && request.resource.data.pointId is string && request.resource.data.pointId.size() > 0 && request.resource.data.pointId.size() <= 128
                    && request.resource.data.pointName is string && request.resource.data.pointName.size() > 0 && request.resource.data.pointName.size() <= 200
                    && request.resource.data.pointCategory is string && request.resource.data.pointCategory.size() > 0 && request.resource.data.pointCategory.size() <= 100
                    && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 100
                    && request.resource.data.details is string && request.resource.data.details.size() <= 2000
                    && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Cartography points collection: anyone can read and create pins, only admins can update/delete
    match /cartography_points/{pointId} {
      allow read, get, list: if true;
      allow create: if isValidId(pointId)
                    && request.resource.data.keys().hasAll(['mapId', 'lng', 'lat', 'note', 'createdAt'])
                    && request.resource.data.keys().size() == 5
                    && request.resource.data.mapId is string
                    && request.resource.data.lng is number
                    && request.resource.data.lat is number
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 120
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Overrides collection
    match /overrides/{overrideId} {
      allow read, get, list: if true;
      allow write, create, update, delete: if isAdmin();
    }
  }
}
